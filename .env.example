# Names only. Values live in Cloudflare (Settings → Build → Variables AND Settings → Variables and Secrets).

# Site address used for canonical links, sitemap and share images. Cloudflare build + runtime.
NEXT_PUBLIC_SITE_URL=https://isitlowfodmap.com
# "off" until launch day: every page gets noindex and robots.txt blocks crawling. Delete it on launch day, then Retry build.
SITE_INDEXING=off
# Sentry DSN (from sentry.io → Project → Client Keys). Runtime variable.
SENTRY_DSN=
